# Browser-visible. Inlined into the client bundle at build time -- never put a
# secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000

# Server-only. On a VPS this is the private address of the FastAPI container,
# so BFF calls never leave the Docker network.
INTERNAL_API_URL=http://localhost:8000
