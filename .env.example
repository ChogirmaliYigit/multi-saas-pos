# ---------------------------------------------------------------------------
# VPS deployment. Copy to .env next to docker-compose.yml and fill in.
#
#   cp .env.example .env
#   ./deployment/scripts/generate-secrets.sh >> .env    # fills the blanks below
#
# .env is gitignored. Everything in here is a secret except the domains.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
LOG_LEVEL=INFO

# Signs every JWT. Rotating it invalidates all sessions immediately.
# openssl rand -base64 48
SECRET_KEY=

# --- database --------------------------------------------------------------
POSTGRES_DB=pos

# Schema owner. Used ONLY by Alembic.
POSTGRES_ADMIN_USER=pos
POSTGRES_ADMIN_PASSWORD=

# The role the API and workers connect as. Created by migration 0004 and
# deliberately unprivileged -- PostgreSQL exempts superusers and table owners
# from row level security, so using the admin role here would silently switch
# off tenant isolation at the database layer.
POSTGRES_APP_USER=pos_app
POSTGRES_APP_PASSWORD=

# --- domains ---------------------------------------------------------------
# Root domain. Shops live on subdomains: shop1.saas-pos.com
BASE_DOMAIN=saas-pos.com

# Origins allowed to call the API. Comma-separated, no spaces. The API also
# accepts any *.BASE_DOMAIN origin via a regex, so tenant subdomains work
# without listing each one.
CORS_ORIGINS=https://saas-pos.com,https://app.saas-pos.com

# Where the browser reaches the API. Baked into the frontend bundle at build
# time, so changing it means rebuilding the frontend image.
NEXT_PUBLIC_API_URL=https://api.saas-pos.com

# For certbot registration and expiry warnings.
CERTBOT_EMAIL=ops@saas-pos.com

# --- bootstrap platform operator -------------------------------------------
# Created on first `docker compose up` by the migrate service. Leave blank to
# skip, then create the account another way.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- sizing ----------------------------------------------------------------
# Rule of thumb: (2 x cores) + 1, capped by available RAM.
API_WORKERS=4
WORKER_CONCURRENCY=2
REPORT_RETENTION_HOURS=48

# Tag applied to built images. `deploy.sh` sets this to the git SHA so a
# rollback is a one-line tag change.
IMAGE_TAG=latest
