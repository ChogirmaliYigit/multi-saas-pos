# Generate with: openssl rand -base64 48
SECRET_KEY=change-me-to-at-least-32-characters-long-random-string
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Runtime role: unprivileged on purpose. PostgreSQL exempts superusers and
# table owners from RLS, so connecting as either would silently disable
# tenant isolation at the database layer.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pos_app
POSTGRES_PASSWORD=change-me-app
POSTGRES_DB=pos
# Owns the schema; used only by Alembic.
POSTGRES_ADMIN_USER=pos
POSTGRES_ADMIN_PASSWORD=change-me-admin

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

BASE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

# Created by `python -m app.db.seed` when both are set.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- email ------------------------------------------------------------
# Leave SMTP_HOST blank and outgoing mail is logged instead of sent, so
# password reset does not silently half-work when nobody configured mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=POS <no-reply@example.com>

# Where reset links point. The frontend, not the API.
APP_BASE_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=60
